# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL="postgresql://touchline:touchline_dev_pw@localhost:5432/touchline"

# Signs the session tokens. Generate one with:  openssl rand -base64 32
JWT_SECRET="change-me-before-deploying"

PORT=4000

# ── Real football data ────────────────────────────────────────────────────
# Free key from https://dashboard.api-football.com (100 requests/day).
# Check what a key can reach before wiring it in:
#   node scripts/check-football-key.mjs YOUR_KEY 2026
FOOTBALL_PROVIDER=api-football
FOOTBALL_API_KEY=
# API-Football's free plan only serves seasons 2022-2024; the current season
# needs a paid plan. Build and test against 2024, then change this one value
# after subscribing — nothing in the code cares which season it is.
FOOTBALL_SEASON=2024

# ── Background jobs ───────────────────────────────────────────────────────
# The scheduler closes auction windows, auto-fills squads and pulls results.
# Set to 0 on every instance but one if you ever run more than one process:
# two schedulers would both tick and waste the daily provider quota.
ENABLE_SCHEDULER=1
SCHEDULE_WINDOW_MINUTES=1
SCHEDULE_FIXTURES_MINUTES=180
SCHEDULE_RESULTS_MINUTES=20
SYNC_RESULT_LIMIT=10
