{
  "name": "touchline-fantasy",
  "private": true,
  "workspaces": [
    "server",
    "mobile"
  ],
  "scripts": {
    "server:dev": "npm run dev --workspace server",
    "server:build": "npm run build --workspace server",
    "server:migrate": "npm run prisma:deploy --workspace server",
    "server:seed": "npm run seed --workspace server",
    "mobile:start": "npm run start --workspace mobile",
    "mobile:web": "npm run web --workspace mobile",
    "mobile:android": "npm run android --workspace mobile",
    "mobile:ios": "npm run ios --workspace mobile",
    "typecheck": "npm run --workspace server build -- --noEmit && tsc -p mobile/tsconfig.json --noEmit"
  }
}
